# 复制为 ~/.config/techshare/.env 后填真实值（项目目录内永不放 .env；文件 chmod 600）
PORT=3000

# ---- MySQL（compose/手动启动时 DB_HOST 填容器名；本机直连填 localhost） ----
DB_HOST=ts-mysql
DB_USER=root
DB_PASSWORD=改成强密码
DB_NAME=tech_share
DB_PORT=3306
DB_POOL_LIMIT=30

# ---- 站点 ----
CORS_ORIGIN=http://localhost:8080
JWT_SECRET=改成随机长字符串（如 openssl rand -hex 32，缺失则后端拒绝启动）
JWT_EXPIRES_IN=24h（登录有效期，jsonwebtoken 格式如 2h/24h/7d，默认 24h；改短更安全，改长体验更好）
CLUSTER=1

# ---- 对象存储（标准 S3 / R2；不填则回落本地 uploads/） ----
# 【方案 R2】填这组：
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://pub-xxx.r2.dev
#
# 【方案 自建/兼容 S3】填这组（R2_* 留空）：
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=你的桶名
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=桶的公开访问域名（无则留空，下载走临时签名）

# ---- Redis 列表缓存（不配则自动直查 DB；compose 里 app 已默认指向 redis 服务） ----
# REDIS_URL=redis://redis:6379
# 有密码时：REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379（start.sh/compose 会按 REDIS_PASSWORD 自动拼）
# REDIS_PASSWORD=随机字符串（如 openssl rand -base64 18 | tr -dc A-Za-z0-9 | head -c 24）
# CACHE_TTL_SEC=45

# ---- 限流（默认：API 1000/分、登录 60/15分、注册 10/小时、上传 120/小时；Redis 共享计数，多 worker 不翻倍） ----
# 注意：rootless podman 的 NAT 会把所有外网 IP 折成一个，限流实质是全局的；
# 个人站建议 API 放到 60000（约 1000/s 熔断），有真公网/LB 再调回 1000 按 IP 限。
# LIMIT_API_PER_MIN=60000
# LIMIT_AUTH_PER_15MIN=60
# LIMIT_UPLOAD_PER_HOUR=120
# LIMIT_LIKE_PER_MIN=30
# LIMIT_AVATAR_PER_HOUR=10
# LIMIT_REGISTER_PER_HOUR=10（注册收紧，防批量刷号堆存储账单）
# QUOTA_BYTES=536870912（每用户累计存储配额，默认 512MB；0 = 不限；删文件即释放）
